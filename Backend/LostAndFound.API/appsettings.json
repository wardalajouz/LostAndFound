{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Findly",
    "Audience": "Findly",
    "ExpiryMinutes": 60
  },
  "Email": {
    "FromAddress": "no-reply@findly.local",
    "FromName": "Findly"
  },
  "Support": {
    "InboxEmail": "support@findly.local"
  },
  "Frontend": {
    "ResetPasswordUrl": "http://localhost:5173/reset-password"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Support": {
      "PermitLimit": 5,
      "WindowSeconds": 600
    },
    "Messages": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  }
}
